{
    "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
    "python.analysis.extraPaths": [
        "${workspaceFolder}",
        "${workspaceFolder}/osm2terrn"
    ],
    "python.analysis.autoImportCompletions": true,
    "python.testing.pytestArgs": [
        "tests"
    ],
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.terminal.activateEnvironment": true,
    "python.envFile": "${workspaceFolder}/.env",
    "chatgpt.openOnStartup": true,
    "chat.tools.terminal.autoApprove": {
        "/^pytest -q tests/test_geometry_utils\\.py tests/test_elevation_cache\\.py tests/test_heightmap_cache\\.py tests/test_domain_architecture\\.py tests/test_domain_adapters_cache\\.py tests/test_pipeline_domain_state\\.py tests/test_osm_data_handler_cache\\.py$/": {
            "approve": true,
            "matchCommandLine": true
        }
    }
}
